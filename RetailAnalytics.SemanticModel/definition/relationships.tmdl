relationship fct_sales_dim_date
	fromColumn: fct_sales.date_key
	toColumn: dim_date.date_key

relationship fct_sales_dim_customer
	fromColumn: fct_sales.customer_key_sk
	toColumn: dim_customer.customer_key_sk

relationship fct_sales_dim_product
	fromColumn: fct_sales.product_key
	toColumn: dim_product.product_key

relationship fct_sales_dim_country
	fromColumn: fct_sales.country_key
	toColumn: dim_country.country_key

